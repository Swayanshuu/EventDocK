# ==============================================================================
# EventDock Platform Configuration Template
# Copy this file to .env and customize values for your local or staging environment.
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# Database Configuration (PostgreSQL)
EVENTDOCK_DB_HOST=localhost
EVENTDOCK_DB_PORT=5432
EVENTDOCK_DB_NAME=eventdock
EVENTDOCK_DB_USER=eventdock_user
EVENTDOCK_DB_PASSWORD=change_me_in_production_db_secret

# EventDock API Server Configuration
EVENTDOCK_SERVER_PORT=8080
EVENTDOCK_BASE_URL=http://localhost:8080
EVENTDOCK_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5000,http://localhost:5173

# Security & Authentication (JWT for Dashboard and CLI)
# Generate a cryptographically secure 256-bit+ secret in production:
# openssl rand -base64 48
EVENTDOCK_JWT_SECRET=super_secret_jwt_signing_key_replace_for_production_min_32_bytes_long!
EVENTDOCK_JWT_EXPIRATION_MINUTES=1440

# Ingestion & API Limits
EVENTDOCK_MAX_EVENT_PAYLOAD_BYTES=65536
EVENTDOCK_MAX_STACK_TRACE_LENGTH=32768
EVENTDOCK_INGESTION_RATE_LIMIT_RPS=100
EVENTDOCK_DEFAULT_RETENTION_DAYS=30

# SSRF & Replay Destination Policy
# Semicolon-delimited regex or hostnames allowed for replay in local/staging development
EVENTDOCK_REPLAY_ALLOWED_HOSTS=localhost,127.0.0.1,api-dev.linkpeer.internal,staging.linkpeer.internal
EVENTDOCK_REPLAY_ALLOW_LOCAL_DEV=true
EVENTDOCK_REPLAY_TIMEOUT_SECONDS=10

# Sample Application (LinkPeer demo) Configuration
SAMPLE_APP_PORT=8081
SAMPLE_EVENTDOCK_ENDPOINT=http://localhost:8080
SAMPLE_EVENTDOCK_API_KEY=ed_live_example_replace_with_project_key
SAMPLE_EVENTDOCK_ENABLED=true

# Waitlist Landing Website (Direct Frontend to DB & Resend Emailing)
# Pass via --dart-define when compiling or running Flutter Web
SUPABASE_URL=https://grgtlaeinlgbrejymwts.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=EventDock <onboarding@resend.dev>

